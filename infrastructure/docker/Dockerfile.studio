FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* turbo.json ./
COPY apps/studio-web/package.json apps/studio-web/package.json
COPY packages/persona-schema/package.json packages/persona-schema/package.json
COPY packages/sdk-typescript/package.json packages/sdk-typescript/package.json
RUN npm install

FROM deps AS build
COPY . .
RUN npm run build -- --filter=@vowhumans/studio-web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/studio-web/.next/standalone ./
COPY --from=build /app/apps/studio-web/.next/static ./apps/studio-web/.next/static
COPY --from=build /app/apps/studio-web/public ./apps/studio-web/public
EXPOSE 3000
CMD ["node", "apps/studio-web/server.js"]

