FROM python:3.12-slim
ARG SERVICE_PATH
ENV SERVICE_PATH=${SERVICE_PATH} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY ${SERVICE_PATH}/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY ${SERVICE_PATH} /app/service
EXPOSE 8000
CMD ["uvicorn", "main:app", "--app-dir", "/app/service", "--host", "0.0.0.0", "--port", "8000"]

