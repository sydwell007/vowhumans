{
  "name": "vowhumans",
  "version": "0.1.0",
  "private": true,
  "description": "GoalVow's consent-first digital human platform",
  "packageManager": "npm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@vowhumans/studio-web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:python": "python -m unittest discover services -p test_*.py && python -m compileall -q services packages/sdk-python",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:python",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.8.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

