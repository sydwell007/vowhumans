# Local-only build artifacts. Harmless to omit under normal git-based deploys (these are
# already gitignored, so git-based deploys never see them) but required for `vercel deploy`
# run directly from a local checkout, which uploads the raw filesystem rather than the git
# tree and would otherwise sweep in every node_modules/.next across the whole monorepo.
node_modules
.next
.turbo
coverage
dist

# Backend source and operator-only deployment artifacts must never be served by Vercel.
/public/php
/public/sql
/backend-artifacts
/services
/infrastructure
/docs
**/*.sql
# packages/database/migrations/*.sql is never web-servable either way — it sits
# outside apps/studio-web/public, so Next.js never routes to it regardless of
# this file. But scripts/migrate-workforce.mjs and migrate-schema-fixes.mjs
# read these files server-side during `npm run build`'s prebuild step to apply
# pending schema changes to the real database, and the blanket **/*.sql rule
# above was silently excluding them from every Vercel build entirely — the
# scripts appeared to run but always failed on a missing file. See
# docs/DEPLOYMENT.md before narrowing this further.
!packages/database/migrations/*.sql
**/*.zip
.env*
!.env.example
