# Web and API
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
API_GATEWAY_URL=http://localhost:8000
# The realtime-agent-worker service (the actual voice bridge) has no public
# network of its own — this is its separate health-only companion service
# (services/realtime-agent/main.py), used by the Live Sessions page to show a
# real "OpenAI Realtime: configured" signal instead of guessing. Optional —
# without it the health panel honestly shows "unknown" rather than a fake yes/no.
REALTIME_AGENT_HEALTH_URL=http://localhost:8001
VOWHUMANS_SERVICE_API_KEY=replace-with-32-plus-random-characters
# Signs the short-lived embed token studio-web mints server-side for /embed live
# calls (apps/studio-web/src/lib/embedToken.ts). Must match on api-gateway too.
VOWHUMANS_EMBED_TOKEN_SECRET=replace-with-32-plus-random-characters
AUTH_SECRET=replace-with-64-plus-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_COOKIE_DOMAIN=localhost
DATABASE_URL=postgresql://vowhumans:vowhumans@localhost:5432/vowhumans
RUN_WORKFORCE_MIGRATIONS=false
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=vowhumans
MARIADB_USER=vowhumans_api
MARIADB_PASSWORD=replace-me
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vowhumans-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_REGION=af-south-1
S3_PUBLIC_BASE_URL=

# Realtime providers (server-side only)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_IMAGE_MODEL=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TTS_PROVIDER=disabled
TTS_API_KEY=
AVATAR_PROVIDER=static
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
# avatar-worker's current RunPod proxy URL — changes every time the pod is deleted
# and redeployed fresh (not on Stop/Start).
AVATAR_WORKER_URL=
# Server-to-server base URL for studio-web, used by avatar-participant to fetch a
# digital human's assigned face bytes without a browser session cookie.
STUDIO_WEB_URL=http://localhost:3000
# Shared secret for every internal (non-browser, non-cookie) call between services:
# studio-web <-> avatar-worker, avatar-participant <-> studio-web/avatar-worker.
VOWHUMANS_INTERNAL_KEY=replace-with-32-plus-random-characters

# Payments, tax and marketplace (server-side only)
BILLING_PROVIDER=disabled
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VAT_RATE=0.15
MARKETPLACE_COMMISSION_RATE=0.20

# Email, support and monitoring
EMAIL_PROVIDER=disabled
EMAIL_FROM=noreply@vowhumans.com
RESEND_API_KEY=
SUPPORT_EMAIL=support@vowhumans.com
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Feature flags: safe CPU-first defaults
ENABLE_OPENAI_REALTIME=false
ENABLE_LIVEKIT=false
ENABLE_MUSETALK=false
ENABLE_AVATAR_PARTICIPANT=false
ENABLE_LIVEPORTRAIT=false
ENABLE_AUDIO2FACE=false
ENABLE_PRESENTER_STUDIO=true
ENABLE_PUBLIC_MARKETING_SITE=true
ENABLE_STUDIO=true
ENABLE_DIGITAL_WORKFORCE=true
ENABLE_DIGITAL_COLLEAGUES=true
# Optional drafting assistance. Generated role recommendations are labelled and
# can never approve or deploy a Digital Colleague.
ENABLE_WORKFORCE_AI_GENERATION=false
# Optional provider execution for reviewable work products. Keep disabled until
# an approved provider/model policy and credentials have been configured.
ENABLE_WORKFORCE_MODEL_EXECUTION=false
# External side effects and scheduled work remain separately gated.
ENABLE_WORKFORCE_TOOL_EXECUTION=false
ENABLE_WORKFORCE_SCHEDULES=false
# Post-deployment operations. Control-plane testing is safe to enable; external
# production execution remains independently gated and off by default.
ENABLE_TEST_CENTRE=true
ENABLE_SANDBOX_TASK_RUNNER=true
ENABLE_RUNTIME_HEALTH=true
ENABLE_WORK_QUEUE=true
ENABLE_WORK_PRODUCTS=true
ENABLE_HUMAN_REVIEWS=true
ENABLE_PROVIDER_HEALTH=true
ENABLE_DEPLOYMENT_PROMOTION=true
ENABLE_PRODUCTION_RUNTIME=false
AFRIHOST_API_BASE_URL=
ENABLE_LIVE_SESSIONS=false
ENABLE_MARKETPLACE=true
ENABLE_MARKETPLACE_PURCHASES=false
ENABLE_MARKETPLACE_PAYOUTS=false
ENABLE_PARTNER_PORTAL=true
ENABLE_ACADEMY=true
ENABLE_BILLING=true
ENABLE_PAYFAST=false
ENABLE_STRIPE=false
ENABLE_ENTERPRISE_SSO=false
ENABLE_TRANSCRIPTS=false
ENABLE_RECORDINGS=false
ENABLE_PUBLIC_DEMOS=true
ENABLE_ANALYTICS=true
ENABLE_MOBILE_PWA=true
ENABLE_INVESTOR_DATA_ROOM=false

# South African multilingual architecture — see docs/MULTILINGUAL_AUDIT.md and
# docs/MULTILINGUAL_IMPLEMENTATION_REPORT.md. All default false: the existing
# English-only experience is unchanged unless ENABLE_MULTILINGUAL is turned on.
ENABLE_MULTILINGUAL=false           # master switch — GET /api/v1/languages and every language-aware code path stay English-only until this is true
ENABLE_AUTO_LANGUAGE_DETECTION=false # lets Settings -> Languages' "Test transcription" omit a language and auto-detect instead of requiring one
ENABLE_LANGUAGE_SWITCHING=false     # POST live-sessions/:id/switch-language (mid-call language change)
ENABLE_OPENAI_STT=false             # POST languages/test-transcription (real Whisper calls from the admin test tool)
ENABLE_OPENAI_TTS=false             # the TTS branch of POST languages/benchmark's provider comparison — NOT Presenter Studio/Voice Library narration, which is unaffected by this flag and always on when OPENAI_API_KEY is set
ENABLE_TRANSLATION_FALLBACK=false   # POST presenter-projects/:id/translate-scene, and the translation branch of languages/benchmark and Persona "Translate with AI"
ENABLE_LANGUAGE_BENCHMARKING=false  # POST languages/benchmark itself (Settings -> Languages "Compare providers")
# These two are declared and seeded into language_capabilities (status
# 'unsupported') but have no real provider code behind them yet — no Azure/Google
# credentials exist in this environment. Setting them true has no functional
# effect until Phase 2 actually implements SpeechToTextProvider/TextToSpeechProvider
# for these vendors (see docs/MULTILINGUAL_MODEL_LICENCE_REVIEW.md).
ENABLE_AZURE_SPEECH=false
ENABLE_GOOGLE_SPEECH=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TRANSLATOR_KEY=
GOOGLE_SPEECH_CREDENTIALS_JSON=

# Afrihost PHP adapter
VOWHUMANS_CONFIG_FILE=/home/ACCOUNT/private/vowhumans-config.php
VOWHUMANS_ALLOWED_ORIGIN=https://vowhumans.com
VOWHUMANS_TRUSTED_PROXY=
